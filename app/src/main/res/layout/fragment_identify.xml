<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/identify_music_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♫"
        android:textColor="@color/color_primary"
        android:textSize="76sp"
        android:gravity="center"
        android:padding="16dp" />

    <Button
        android:id="@+id/btn_identify_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lịch sử nhận diện"
        android:textColor="@color/text_white"
        android:textAllCaps="false"
        android:background="@drawable/bg_shortcut_playlist"
        app:backgroundTint="@null"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_listen_identify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhấn để nghe"
        android:textColor="@color/text_white"
        android:textAllCaps="false"
        android:background="@drawable/bg_purple_button"
        app:backgroundTint="@null"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Musibility ghi âm 10 giây bằng microphone và gửi tới AudD để nhận diện. Ứng dụng không đọc âm thanh nội bộ đang phát; hãy cấp quyền microphone khi được hỏi."
        android:textColor="@color/text_light_gray"
        android:textSize="14sp"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/identify_result_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
