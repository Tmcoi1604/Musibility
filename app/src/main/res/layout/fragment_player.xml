<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/player_cover_image"
        android:layout_width="@dimen/cover_size_large"
        android:layout_height="@dimen/cover_size_large"
        android:scaleType="centerCrop"
        android:contentDescription="@string/nav_player"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/player_song_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_white"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center_horizontal" />

    <TextView
        android:id="@+id/player_song_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/color_primary"
        android:textSize="16sp"
        android:gravity="center_horizontal"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/player_song_album"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        android:gravity="center_horizontal"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/player_song_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_light_gray"
        android:textSize="12sp"
        android:gravity="center_horizontal"
        android:paddingTop="2dp" />

    <!-- SeekBar and Time -->
    <SeekBar
        android:id="@+id/player_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/player_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0:00 / 0:00"
        android:textColor="@color/text_light_gray"
        android:textSize="12sp"
        android:gravity="center_horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/player_primary_controls"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/player_btn_shuffle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/color_primary"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="Shuffle" />

        <ImageButton
            android:id="@+id/player_btn_previous"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_previous"
            android:tint="@color/text_white"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/player_btn_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_player_play"
            android:src="@drawable/ic_pause"
            android:tint="@color/text_white"
            android:contentDescription="Play" />

        <ImageButton
            android:id="@+id/player_btn_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_next"
            android:tint="@color/text_white"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="Next" />

        <ImageButton
            android:id="@+id/player_btn_repeat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_repeat"
            android:tint="@color/text_light_gray"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="Repeat one" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_secondary_controls"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <ImageButton
            android:id="@+id/player_btn_add_playlist"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_playlist"
            android:tint="@color/text_white"
            android:padding="12dp"
            android:contentDescription="Add to Playlist" />

        <ImageButton
            android:id="@+id/player_btn_share"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:tint="@color/text_white"
            android:padding="12dp"
            android:contentDescription="Share" />

        <ImageButton
            android:id="@+id/player_btn_lyrics"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_lyrics"
            android:tint="@color/text_white"
            android:padding="12dp"
            android:contentDescription="Lyrics" />

        <ImageButton
            android:id="@+id/player_btn_download"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_downloads"
            android:tint="@color/text_white"
            android:padding="12dp"
            android:contentDescription="Download" />
    </LinearLayout>

</LinearLayout>
