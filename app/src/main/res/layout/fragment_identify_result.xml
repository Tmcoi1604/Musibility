<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/identify_result_heading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Bài hát được nhận diện"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_close_identify_result"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng kết quả nhận diện"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="×"
            android:textColor="@color/text_white"
            android:textSize="30sp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/identify_result_cover"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:background="@color/bg_card"
        android:contentDescription="Bìa album"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/identify_result_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_white"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/identify_result_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:textColor="@color/color_primary"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btn_search_identified_song"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_purple_button"
        android:text="Tìm bài hát này"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        app:backgroundTint="@null" />

    <Button
        android:id="@+id/btn_identify_result_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_shortcut_playlist"
        android:text="Lịch sử nhận diện"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        app:backgroundTint="@null" />

</LinearLayout>
